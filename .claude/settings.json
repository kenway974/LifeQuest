{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:watch)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run format)",
      "Bash(npm run db:types)",
      "Bash(npm run db:seed:add)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(git remote -v)"
    ],
    "deny": [
      "Bash(npm run db:seed)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
