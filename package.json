{
  "name": "lifequest",
  "version": "0.1.0",
  "private": true,
  "description": "Application web gamifiée de développement personnel — transformez votre vie en aventure RPG",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.46.1",
    "@tanstack/react-query": "5.62.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.12.1",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "17.4.0",
    "tailwind-merge": "2.5.5",
    "web-push": "3.6.7",
    "zod": "3.23.8",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "22.10.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "eslint": "9.16.0",
    "eslint-config-next": "16.2.6",
    "patch-package": "^8.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.1",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tailwindcss": "^4.3.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
