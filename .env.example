# ============================================================
# LifeQuest — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local` to git.
# ============================================================

# --- Site URL (used for SEO, OG, sitemap, redirects) ---
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# SUPABASE — Auth + Database + Storage
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ============================================================

# Public — exposed to the browser (anon key is safe to expose if RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never expose. Used for admin operations & seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Used by `npm run db:types` script
SUPABASE_PROJECT_ID=your-project-ref

# Personal Access Token pour le CLI Supabase (génération des types)
# Génère-le sur https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxx

# ============================================================
# STRIPE — Payment for custom quests (€2 one-time)
# Get these from: https://dashboard.stripe.com/apikeys
# ============================================================

# Public (publishable key) — safe to expose
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Server-only (secret key)
STRIPE_SECRET_KEY=sk_test_xxxxx

# Webhook signing secret — get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price ID for the €2 lifetime unlock
# Create a product in Stripe → grab the price ID
STRIPE_CUSTOM_QUESTS_PRICE_ID=price_xxxxx

# ============================================================
# WEB PUSH — Notifications
# Generate VAPID keys with: npx web-push generate-vapid-keys
# ============================================================

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contact@your-domain.com
